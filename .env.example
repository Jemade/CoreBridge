# ════════════════════════════════════════════════════════════════
# COREBRIDGE FULL-STACK ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════════

# ── General Settings ──
PROJECT_NAME="Corebridge Operational Platform"
ENVIRONMENT=production

# ── Security & Authentication ──
# Generate a strong 64-character random string in production: openssl rand -hex 32
SECRET_KEY=replace-with-a-very-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Initial Superuser / Admin Credentials ──
FIRST_SUPERUSER_EMAIL=admin@corebridge.co.zw
FIRST_SUPERUSER_PASSWORD=CorebridgeAdmin2025!

# ── Database (PostgreSQL) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=corebridge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/corebridge

# ── Redis (Rate Limiting & Caching) ──
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# ── Email & Notifications (SMTP) ──
# Leave blank to log emails to console in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=notifications@corebridge.co.zw
ADMIN_NOTIFICATION_EMAIL=info@corebridge.co.zw

# ── Frontend Configuration ──
VITE_API_BASE_URL=/api/v1
